# Copy this file to .env and fill in real values. Never commit .env.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/trendi?retryWrites=true&w=majority
JWT_SECRET=long-random-string
PORT=5000
# Comma-separated list of frontend URLs allowed to call the API (production only)
CLIENT_URL=http://localhost:5173
